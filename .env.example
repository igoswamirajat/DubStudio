# DubStudio configuration (copy to .env). All app settings use the DUBSTUDIO_ prefix.

# --- Server ---
DUBSTUDIO_HOST=127.0.0.1
DUBSTUDIO_PORT=8080
DUBSTUDIO_MAX_UPLOAD_MB=500

# --- ASR (speech-to-text) ---
# faster-whisper | mock
DUBSTUDIO_ASR_ENGINE=faster-whisper
# tiny | base | small | medium | large-v3 | large-v3-turbo
DUBSTUDIO_WHISPER_MODEL=large-v3
DUBSTUDIO_WHISPER_DEVICE=auto
DUBSTUDIO_WHISPER_COMPUTE_TYPE=auto

# --- Separation (Demucs) ---
DUBSTUDIO_SKIP_SEPARATION=0
DUBSTUDIO_DEMUCS_MODEL=htdemucs

# --- Diarization (pyannote) ---
# Requires a HuggingFace token AND accepting the model terms on huggingface.co.
DUBSTUDIO_ENABLE_DIARIZATION=1
DUBSTUDIO_DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
DUBSTUDIO_MAX_SPEAKERS=0

# --- Translation ---
# ollama | openai | demo
DUBSTUDIO_TRANSLATOR=ollama
# ollama (local, offline)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# openai = any OpenAI-compatible API (OpenAI / Groq / DeepSeek / OpenRouter / Ollama /v1)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- TTS ---
# omnivoice | chatterbox | dummy
DUBSTUDIO_TTS_ENGINE=omnivoice

# --- Models / auth ---
# HuggingFace token (used by pyannote diarization). Also accepted as HF_TOKEN.
HF_TOKEN=
# Model cache dir (Whisper / OmniVoice / Demucs / pyannote). Put on a drive with
# space — these downloads are several GB. Also accepted as HF_HOME.
DUBSTUDIO_HF_HOME=

# --- Runtime ---
DUBSTUDIO_LOW_VRAM=0
